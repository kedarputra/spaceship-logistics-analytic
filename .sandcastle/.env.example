# Claude Code OAuth token: run `claude setup-token` on your host with the Claude
# account this project should use, and paste the result. Lets the agent use the
# subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead (uncomment and fill in):
# ANTHROPIC_API_KEY=

# Issue tracker: none needed. Tickets are markdown files under .scratch/, read by
# .sandcastle/tracker.mjs with no token and no network.

# In a Claude Code cloud session this file is not available (it is gitignored).
# Set the same variables in the cloud environment's settings instead.
