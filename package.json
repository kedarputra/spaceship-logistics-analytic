{
  "name": "spaceship-logistics-analytics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "check": "npm run typecheck && npm run test && npm run build",
    "smoke:llm": "tsx --env-file-if-exists=.env.local scripts/smoke-llm.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "users": "tsx --env-file-if-exists=.env.local scripts/users.ts",
    "sandcastle": "tsx .sandcastle/main.mts",
    "sandcastle:cloud": "SANDCASTLE_SANDBOX=none tsx .sandcastle/main.mts",
    "tickets": "node .sandcastle/tracker.mjs status"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "next": "16.4.6",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
