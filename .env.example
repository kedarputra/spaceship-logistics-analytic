# Copy to .env.local for local runs. Never commit real values. See docs/adr/0009-llm-layer.md.

# OpenAI-compatible LLM gateway on the home server. Not reachable from outside it.
LLM_BASE_URL=http://127.0.0.1:4000/v1

# Gateway model name. "chat" follows the server's ACTIVE chat model (Gemma 4 12B).
LLM_MODEL=chat

# Optional. The model as the page names it, since LLM_MODEL may be an alias. Defaults to Gemma 4 12B.
# LLM_MODEL_DISPLAY_NAME=Gemma 4 12B

# Path to a file that holds the gateway client key (the key itself is never in the repo).
# Without it the dashboard still works and the ask box says AI is not configured.
LLM_API_KEY_FILE=

# Optional. How the model is asked for structured output: json_schema (the default) has the gateway
# enforce the schema; json_object puts it in the prompt, for a gateway that does not enforce it.
# `npm run smoke:llm` tells you which one your gateway supports.
# LLM_RESPONSE_MODE=json_schema
